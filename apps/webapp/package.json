{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm run prisma:contract:emit",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "prisma:contract:infer": "dotenvx run -- prisma contract infer --output ./src/prisma/contract.prisma",
    "prisma:contract:emit": "prisma contract emit",
    "prisma:db:update": "dotenvx run -- prisma db update",
    "prisma:db:sign": "dotenvx run -- prisma db sign",
    "prisma:studio": "prisma studio",
    "react:email": "email dev --dir ./src/emails --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@dotenvx/dotenvx": "^2.22.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@repo/data-commons": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "input-otp": "^1.5.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.21.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.12",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "next-safe-action": "^8.6.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.11.0",
    "smtp-server": "^3.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^8.0.0-rc.12",
    "react-email": "^6.9.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
